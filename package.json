{
  "name": "traslados-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación de escritorio del registro privado de traslados matrimoniales",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:mac": "electron-builder --mac dmg zip --publish never",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:dir": "electron-builder --dir --publish never"
  },
  "dependencies": { "electron-updater": "6.8.9" },
  "devDependencies": { "electron": "44.8.0", "electron-builder": "26.15.3" },
  "build": {
    "appId": "com.sistemascacl.traslados",
    "productName": "Traslados",
    "asar": true,
    "directories": { "output": "dist", "buildResources": "assets" },
    "files": ["src/**/*", "assets/icon.png", "assets/heart.svg", "package.json"],
    "artifactName": "Traslados-${version}-${os}-${arch}.${ext}",
    "publish": [{ "provider": "github", "owner": "sistemascalc", "repo": "traslados-desktop", "releaseType": "release" }],
    "mac": { "category": "public.app-category.productivity", "icon": "assets/icon.icns", "target": ["dmg", "zip"], "hardenedRuntime": true },
    "win": { "icon": "assets/icon.ico", "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Traslados", "deleteAppDataOnUninstall": false }
  }
}
